# Puerto donde escucha el servidor
PORT=3000

# Conexión a MongoDB. Las transacciones necesitan un replica set, incluso en local.
MONGODB_URI=mongodb://localhost:27017/beverage_distributor?replicaSet=rs0

# Clave para firmar los JWT. Usar una larga y aleatoria. Nunca subirla.
JWT_SECRET=

# Duración del token de sesión
JWT_EXPIRES_IN=1d